# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Dependency directories
vendor/

# IDE specific files
.idea/
.vscode/
*.swp
*.swo

# macOS specific files
.DS_Store

# Project specific
/test/
/config.yaml
/config.test.yaml
/websearch-mcpserver
/websearch
/autostart.vbs
/start-mcp.vbs
*.html
qwen-code-export-*.html

# docs: 官方文档直接跟踪；无关/草稿/历史文档放 docs/archive/ 与 docs/plans/（忽略）
docs/archive/
docs/plans/

# 对外介绍页需要纳入版本管理（控制台内嵌页面仍忽略）
!docs/**/*.html
pkg/dashboard/web/*.html

# wiki knowledge dirs (managed by wiki CLI)
/issues

# 本地工作留档（不提交）
/wiki

# 杀软锁系统 TEMP 的绕行构建目录
.gtmp/

# 会话交接记录（handoff skill 管理不入库）
.handoff/

# 本机运行时产物：控制中心库、跑测留档、日志、工具缓存
/data/
/latest_logs/
/tmp/
*.log
/.codegraph/
/.playwright-mcp/

# 凭据与打包产物：发布走 npm Trusted Publishing（OIDC），CI 不需要任何长期
# token；这里仍挡住误提交的 .npmrc（常含 auth token 赋值）、.env 与 tgz。
.npmrc
.env
.env.*
*.tgz

# 本机工作留档（会话记忆等），不入库
/.workbuddy/
